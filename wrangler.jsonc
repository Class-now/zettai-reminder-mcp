{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zettai-reminder-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	// secrets（値はここに書かない）: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY
	"migrations": [{ "new_sqlite_classes": ["ReminderMCP"], "tag": "v1" }],
	"durable_objects": { "bindings": [{ "class_name": "ReminderMCP", "name": "MCP_OBJECT" }] },
	// KV namespace: zettai-reminder-oauth（OAuth トークン専用）
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "8a6d0a7db8ee4560abf2c4cfb08d9293" }],
	// D1: zettai-reminder（location hint enam。claude.ai のツール呼び出しは IAD に着くため）
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zettai-reminder",
			"database_id": "0668dcaf-f680-4d10-a177-5498fb01cd3a",
			"migrations_dir": "migrations"
		}
	],
	"vars": { "ALLOWED_GITHUB_USER_ID": "255099949" },
	"observability": { "enabled": true },
	"dev": { "port": 8789 }
}
